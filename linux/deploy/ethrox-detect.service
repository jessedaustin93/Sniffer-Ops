[Unit]
Description=Ethrox Detect headless awareness hub
Documentation=https://github.com/jessedaustin93/Ethrox-Detect
After=network-online.target bluetooth.target NetworkManager.service
Wants=network-online.target

[Service]
Type=simple
User=ethrox-detect
Group=ethrox-detect
# Data lives on the writable data partition; root can stay read-only.
Environment=ETHROX_DETECT_DATA_DIR=/var/lib/ethrox-detect
ExecStart=/opt/ethrox-detect/venv/bin/python /opt/ethrox-detect/ethrox_detect_linux.py --headless
Restart=always
RestartSec=10

# systemd creates/owns /var/lib/ethrox-detect (0750) and implies ReadWritePaths.
StateDirectory=ethrox-detect
StateDirectoryMode=0750

# ── Light hardening ──────────────────────────────────────────────────────────
# [HW] BlueZ, NetworkManager, and RTL-SDR need device + D-Bus access. These
# supplementary groups + the RTL-SDR udev rule (see lib-install.sh) grant it
# without root. If BT/SDR/NM misbehave on real hardware under ProtectSystem,
# relax to ProtectSystem=full or add the specific DeviceAllow= lines — validate
# on the Pi Zero 2W. This is the most likely place hardening fights hardware.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/ethrox-detect
SupplementaryGroups=bluetooth netdev plugdev dialout

[Install]
WantedBy=multi-user.target
