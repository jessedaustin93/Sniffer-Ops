    {"id": "mdt", "family": "public_safety.mdt_vendor_clue", "label": "Mobile data terminal vendor clue", "patterns": ["mobile[-_\\s]*data[-_\\s]*terminal", "\\bmdt\\b", "getac", "panasonic[-_\\s]*toughbook", "cradlepoint"], "priority": "INFO", "confidence": "LOW"},
