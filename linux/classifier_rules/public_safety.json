    {"id": "stationary-roadside", "family": "public_safety.stationary_roadside_observation", "label": "Stationary roadside public-safety observation", "patterns": ["stationary[-_\\s]*roadside", "roadside[-_\\s]*stop", "enforcement[-_\\s]*position"], "priority": "WATCH", "confidence": "MEDIUM"}
